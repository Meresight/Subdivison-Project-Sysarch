@using GreenMeadowsPortal.ViewModels
@model PayPeriodDetailsViewModel
@{
    ViewData["Title"] = "Pay Period Details - Green Meadows Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Meadows | Pay Period Details</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body>
    <div class="wrapper">
        <!-- Admin Sidebar Navigation -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <h3>Green Meadows</h3>
                <div class="sidebar-logo">GM</div>
            </div>

            <div class="user-profile">
                <div class="user-avatar">
                    <img src="/images/default-avatar.png" alt="Admin Avatar">
                </div>
                <div class="user-info">
                    <h4>Admin</h4>
                    <p>Admin</p>
                </div>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Dashboard" asp-action="AdminDashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                </li>
                <li>
                    <a asp-controller="Dashboard" asp-action="UserManagement"><i class="fas fa-users"></i> User Management</a>
                </li>
                <li>
                    <a asp-controller="Announcement" asp-action="Index"><i class="fas fa-bullhorn"></i> Announcements</a>
                </li>
                <li>
                    <a asp-controller="Dashboard" asp-action="Billing"><i class="fas fa-file-invoice-dollar"></i> Billing</a>
                </li>
                <li>
                    <a href="/FaceRecognition/TimeTracking"><i class="fas fa-clock"></i> Time Tracking</a>
                </li>
                <li>
                    <a href="/FaceRecognition/Enroll"><i class="fas fa-user-plus"></i> Face Enrollment</a>
                </li>
                <li class="active">
                    <a href="/Payroll"><i class="fas fa-money-bill-wave"></i> Payroll</a>
                </li>
                <li>
                    <a href="/Facilities"><i class="fas fa-swimming-pool"></i> Facilities</a>
                </li>
                <li>
                    <a href="/ServiceRequests"><i class="fas fa-tools"></i> Service Requests</a>
                </li>
                <li>
                    <a href="/Documents"><i class="fas fa-file-alt"></i> Documents</a>
                </li>
                <li>
                    <a href="/Forum"><i class="fas fa-comments"></i> Community Forum</a>
                </li>
                <li>
                    <a href="/Security"><i class="fas fa-shield-alt"></i> Security</a>
                </li>
                <li>
                    <a href="/Events"><i class="fas fa-calendar-alt"></i> Events</a>
                </li>
                <li>
                    <a href="/Reports"><i class="fas fa-chart-bar"></i> Reports</a>
                </li>
                <li>
                    <a href="/Settings"><i class="fas fa-cog"></i> Settings</a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="Profile"><i class="fas fa-user-cog"></i> Profile</a>
                <a asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i>Logout</a>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="content-area">
            <!-- Top Navigation -->
            <header class="top-navbar">
                <button id="sidebar-toggle" class="sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="search-bar">
                    <input type="text" placeholder="Search...">
                    <button><i class="fas fa-search"></i></button>
                </div>

                <div class="navbar-right">
                    <div class="notification-bell">
                        <a asp-controller="Notification" asp-action="Index">
                            <i class="fas fa-bell"></i>
                            <span class="notification-count">0</span>
                        </a>
                    </div>

                    <div class="user-dropdown">
                        <img src="/images/default-avatar.png" alt="Admin Avatar">
                        <span>Admin</span>
                        <i class="fas fa-chevron-down"></i>

                        <div class="dropdown-menu">
                            <a asp-controller="Account" asp-action="Profile"><i class="fas fa-user-cog"></i> My Profile</a>
                            <a href="/Settings"><i class="fas fa-cog"></i> Settings</a>
                            <a asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i>Logout</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="main-content">
                <div class="page-header">
                    <h1>Pay Period Details</h1>
                    <nav class="breadcrumb">
                        <a asp-controller="Dashboard" asp-action="AdminDashboard">Admin</a> /
                        <a asp-controller="Payroll" asp-action="Index">Payroll</a> /
                        Pay Period #@Model.PayPeriod.Id
                    </nav>
                </div>

                <!-- Success/Error Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                        <button class="close-alert"><i class="fas fa-times"></i></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                        <button class="close-alert"><i class="fas fa-times"></i></button>
                    </div>
                }

                <div class="content-section">
                    <div class="section-header">
                        <h2>Pay Period Information</h2>
                    </div>

                    <div class="card pay-period-info">
                        <div class="pay-period-details">
                            <div class="detail-item">
                                <span class="label">Period ID:</span>
                                <span class="value">#@Model.PayPeriod.Id</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Start Date:</span>
                                <span class="value">@Model.PayPeriod.StartDate.ToString("MMMM dd, yyyy")</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">End Date:</span>
                                <span class="value">@Model.PayPeriod.EndDate.ToString("MMMM dd, yyyy")</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Status:</span>
                                <span class="value status @Model.PayPeriod.Status.ToLower()">@Model.PayPeriod.Status</span>
                            </div>
                            <div class="detail-item">
                                <span class="label">Duration:</span>
                                <span class="value">@((Model.PayPeriod.EndDate - Model.PayPeriod.StartDate).Days + 1) days</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.PayPeriod.Notes))
                            {
                                <div class="detail-item notes">
                                    <span class="label">Notes:</span>
                                    <span class="value">@Model.PayPeriod.Notes</span>
                                </div>
                            }
                        </div>

                        @if (Model.PayPeriod.Status == "Open")
                        {
                            <div class="action-section">
                                <form asp-action="ProcessPayroll" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="payPeriodId" value="@Model.PayPeriod.Id" />
                                    <button type="submit" class="btn primary-btn">
                                        <i class="fas fa-play-circle"></i> Process Payroll
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>

                <div class="content-section">
                    <div class="section-header">
                        <h2>Employee Payments</h2>
                    </div>

                    @if (!Model.PayPeriod.EmployeePayments.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <h3>No Payments</h3>
                            <p>This pay period has no processed payments yet.</p>
                            @if (Model.PayPeriod.Status == "Open")
                            {
                                <form asp-action="ProcessPayroll" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="payPeriodId" value="@Model.PayPeriod.Id" />
                                    <button type="submit" class="btn primary-btn">
                                        <i class="fas fa-play-circle"></i> Process Payroll
                                    </button>
                                </form>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="payments-table-section">
                            <table class="payments-table">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Days Worked</th>
                                        <th>Total Hours</th>
                                        <th>Regular Hours</th>
                                        <th>Overtime Hours</th>
                                        <th>Gross Pay</th>
                                        <th>Deductions</th>
                                        <th>Net Pay</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.PayPeriod.EmployeePayments)
                                    {
                                        <tr>
                                            <td>
                                                <div class="employee-cell">
                                                    <div class="employee-avatar">
                                                        <img src="@(string.IsNullOrEmpty(payment.User?.ProfileImageUrl) ? "/images/default-avatar.png" : payment.User.ProfileImageUrl)" alt="@payment.User?.FirstName @payment.User?.LastName">
                                                    </div>
                                                    <div class="employee-info">
                                                        <div class="employee-name">@payment.User?.FirstName @payment.User?.LastName</div>
                                                        <div class="employee-position">@payment.User?.Position</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@payment.DaysWorked</td>
                                            <td>@payment.TotalHours.ToString("0.00")</td>
                                            <td>@payment.RegularHours.ToString("0.00")</td>
                                            <td>@payment.OvertimeHours.ToString("0.00")</td>
                                            <td>₱@payment.GrossPay.ToString("N2")</td>
                                            <td>₱@payment.Deductions.ToString("N2")</td>
                                            <td>₱@payment.NetPay.ToString("N2")</td>
                                            <td><span class="status @payment.Status.ToLower()">@payment.Status</span></td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a asp-action="EmployeeTimeRecords"
                                                       asp-route-userId="@payment.UserId"
                                                       asp-route-startDate="@Model.PayPeriod.StartDate.ToString("yyyy-MM-dd")"
                                                       asp-route-endDate="@Model.PayPeriod.EndDate.ToString("yyyy-MM-dd")"
                                                       class="btn small-btn">
                                                        Time Records
                                                    </a>
                                                    @if (payment.Status == "Pending")
                                                    {
                                                        <a href="#" class="btn small-btn primary approve-btn" data-id="@payment.Id">
                                                            Approve
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="5"><strong>Totals</strong></td>
                                        <td><strong>₱@Model.PayPeriod.EmployeePayments.Sum(p => p.GrossPay).ToString("N2")</strong></td>
                                        <td><strong>₱@Model.PayPeriod.EmployeePayments.Sum(p => p.Deductions).ToString("N2")</strong></td>
                                        <td><strong>₱@Model.PayPeriod.EmployeePayments.Sum(p => p.NetPay).ToString("N2")</strong></td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <div class="content-section">
                    <div class="section-header">
                        <h2>Staff Without Payments</h2>
                    </div>

                    @{
                        var staffWithPayments = Model.PayPeriod.EmployeePayments.Select(p => p.UserId).ToList();
                        var staffWithoutPayments = Model.StaffMembers.Where(s => !staffWithPayments.Contains(s.Id)).ToList();
                    }

                    @if (!staffWithoutPayments.Any())
                    {
                        <div class="info-box">
                            <i class="fas fa-info-circle"></i>
                            <p>All staff members have payments processed for this period.</p>
                        </div>
                    }
                    else
                    {
                        <div class="staff-table-section">
                            <table class="staff-table">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Position</th>
                                        <th>Department</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var staff in staffWithoutPayments)
                                    {
                                        <tr>
                                            <td>
                                                <div class="employee-cell">
                                                    <div class="employee-avatar">
                                                        <img src="@(string.IsNullOrEmpty(staff.ProfileImageUrl) ? "/images/default-avatar.png" : staff.ProfileImageUrl)" alt="@staff.FirstName @staff.LastName">
                                                    </div>
                                                    <div class="employee-info">
                                                        <div class="employee-name">@staff.FirstName @staff.LastName</div>
                                                        <div class="employee-email">@staff.Email</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@staff.Position</td>
                                            <td>@staff.Department</td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a asp-action="EmployeeTimeRecords"
                                                       asp-route-userId="@staff.Id"
                                                       asp-route-startDate="@Model.PayPeriod.StartDate.ToString("yyyy-MM-dd")"
                                                       asp-route-endDate="@Model.PayPeriod.EndDate.ToString("yyyy-MM-dd")"
                                                       class="btn small-btn">
                                                        Time Records
                                                    </a>
                                                    <a href="#" class="btn small-btn primary process-individual-btn"
                                                       data-user-id="@staff.Id"
                                                       data-pay-period-id="@Model.PayPeriod.Id">
                                                        Process
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="content-section">
                    <div class="section-header">
                        <h2>Actions</h2>
                    </div>

                    <div class="action-buttons-container">
                        <a asp-action="Index" class="btn secondary-btn">
                            <i class="fas fa-arrow-left"></i> Back to Payroll
                        </a>

                        @if (Model.PayPeriod.Status == "Open")
                        {
                            <form asp-action="ProcessPayroll" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="payPeriodId" value="@Model.PayPeriod.Id" />
                                <button type="submit" class="btn primary-btn">
                                    <i class="fas fa-play-circle"></i> Process Payroll
                                </button>
                            </form>
                        }
                        else if (Model.PayPeriod.Status == "Processing")
                        {
                            <form asp-action="FinalizePayroll" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="payPeriodId" value="@Model.PayPeriod.Id" />
                                <button type="submit" class="btn primary-btn">
                                    <i class="fas fa-check-circle"></i> Finalize Payroll
                                </button>
                            </form>
                        }

                        <a asp-action="ExportPayroll" asp-route-id="@Model.PayPeriod.Id" class="btn info-btn">
                            <i class="fas fa-file-export"></i> Export to Excel
                        </a>

                        <a href="#" class="btn warning-btn" data-toggle="modal" data-target="#printPayslipsModal">
                            <i class="fas fa-print"></i> Print Payslips
                        </a>
                    </div>
                </div>
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                <div class="footer-content">
                    <p>&copy; @DateTime.Now.Year Green Meadows Subdivision. All rights reserved.</p>
                    <div class="footer-links">
                        <a href="/Help">Help Center</a>
                        <a href="/Privacy">Privacy Policy</a>
                        <a href="/Terms">Terms of Service</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Print Payslips Modal -->
    <div class="modal fade" id="printPayslipsModal" tabindex="-1" role="dialog" aria-labelledby="printPayslipsModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="printPayslipsModalLabel">Print Payslips</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Select which payslips to print:</p>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="payslipOption" id="allPayslips" value="all" checked>
                        <label class="form-check-label" for="allPayslips">
                            All payslips
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="payslipOption" id="approvedPayslips" value="approved">
                        <label class="form-check-label" for="approvedPayslips">
                            Approved payslips only
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="payslipOption" id="pendingPayslips" value="pending">
                        <label class="form-check-label" for="pendingPayslips">
                            Pending payslips only
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn secondary-btn" data-dismiss="modal">Cancel</button>
                    <a href="#" class="btn primary-btn" id="printPayslipsBtn">Print Payslips</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // User dropdown toggle
            const userDropdown = document.querySelector('.user-dropdown');
            if (userDropdown) {
                userDropdown.addEventListener('click', function(event) {
                    event.stopPropagation();
                    this.classList.toggle('open');
                    const dropdownMenu = this.querySelector('.dropdown-menu');
                    dropdownMenu.classList.toggle('show');
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function(event) {
                    if (!userDropdown.contains(event.target)) {
                        userDropdown.classList.remove('open');
                        const dropdownMenu = userDropdown.querySelector('.dropdown-menu');
                        if (dropdownMenu) dropdownMenu.classList.remove('show');
                    }
                });
            }

            // Mobile sidebar toggle
            const sidebarToggle = document.getElementById('sidebar-toggle');
            const sidebar = document.getElementById('sidebar');
            if (sidebarToggle && sidebar) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('active');
                });
            }

            // Close alert buttons
            const closeButtons = document.querySelectorAll('.close-alert');
            closeButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    var alert = this.parentElement;
                    alert.style.display = 'none';
                });
            });

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function(alert) {
                    alert.style.display = 'none';
                });
            }, 5000);

            // Approve payment buttons
            const approveButtons = document.querySelectorAll('.approve-btn');
            approveButtons.forEach(function(button) {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const paymentId = this.getAttribute('data-id');
                    if (confirm('Are you sure you want to approve this payment?')) {
                        window.location.href = '/Payroll/ApprovePayment/' + paymentId;
                    }
                });
            });

            // Process individual buttons
            const processButtons = document.querySelectorAll('.process-individual-btn');
            processButtons.forEach(function(button) {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const userId = this.getAttribute('data-user-id');
                    const payPeriodId = this.getAttribute('data-pay-period-id');
                    if (confirm('Are you sure you want to process payment for this employee?')) {
                        window.location.href = '/Payroll/ProcessIndividualPayment?userId=' + userId + '&payPeriodId=' + payPeriodId;
                    }
                });
            });

            // Print payslips button
            const printPayslipsBtn = document.getElementById('printPayslipsBtn');
            if (printPayslipsBtn) {
                printPayslipsBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const payPeriodId = '@Model.PayPeriod.Id';
                    const option = document.querySelector('input[name="payslipOption"]:checked').value;
                    window.open('/Payroll/PrintPayslips?payPeriodId=' + payPeriodId + '&option=' + option, '_blank');
                });
            }
        });
    </script>
</body>
</html>