@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using GreenMeadowsPortal.ViewModels
@model CreatePayPeriodViewModel
@{
    ViewData["Title"] = "Create Pay Period - Green Meadows Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Meadows | Create Pay Period</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body>
    <!-- Your form content here -->
    <div class="content-section">
        <div class="section-header">
            <h2>Pay Period Details</h2>
        </div>

        <form action="/Payroll/CreatePayPeriod" method="post">
            @Html.AntiForgeryToken()
            <input type="date" name="StartDate" value="2025-03-05" required>
            <input type="date" name="EndDate" value="2025-03-14" required>
            <input type="text" name="Notes" value="Test">
            <button type="submit">Test Submit</button>
        </form>
    </div>

    <!-- Include jQuery and validation scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');

            if (form) {
                console.log('Form found:', form);

                // Check if form has anti-forgery token
                const antiForgeryToken = form.querySelector('[name="__RequestVerificationToken"]');
                console.log('Anti-forgery token found:', antiForgeryToken !== null);

                form.addEventListener('submit', function(e) {
                    console.log('Form submit event triggered');
                    console.log('Event default prevented:', e.defaultPrevented);

                    // Log all fields
                    const formData = new FormData(form);
                    console.log('Form data:');
                    for (let pair of formData.entries()) {
                        console.log(pair[0] + ': ' + pair[1]);
                    }
                });

                // Also check for button click
                const submitButton = form.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.addEventListener('click', function(e) {
                        console.log('Submit button clicked');
                    });
                }
            }
        });
    </script>
</body>
</html>