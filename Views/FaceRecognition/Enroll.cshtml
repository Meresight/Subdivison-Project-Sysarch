<!-- Views/FaceRecognition/Enroll.cshtml -->
@model dynamic
@{
    ViewData["Title"] = "Enroll Face - Green Meadows Portal";
    Layout = "_DashboardLayout";
}

<div class="content-section">
    <div class="section-header">
        <h2>Face Enrollment</h2>
    </div>

    <div class="enrollment-container">
        <div class="enrollment-instructions">
            <p>Face enrollment allows you to use facial recognition for time tracking. Please follow these steps:</p>
            <ol>
                <li>Make sure you are in a well-lit area</li>
                <li>Remove glasses, hats, or other items that obscure your face</li>
                <li>Look directly at the camera</li>
                <li>Keep a neutral expression</li>
                <li>Take or upload a clear photo of your face</li>
            </ol>
        </div>

        <div class="enrollment-capture">
            <div class="video-container">
                <video id="video" width="400" height="300" autoplay></video>
                <canvas id="canvas" width="400" height="300" style="display:none;"></canvas>
            </div>
            <div class="capture-controls">
                <button id="capture-btn" class="btn primary-btn">Capture Photo</button>
                <p>Or</p>
                <form asp-action="Enroll" method="post" enctype="multipart/form-data" id="enrollment-form">
                    <div class="form-group">
                        <label for="faceImage" class="form-label">Upload Photo</label>
                        <input type="file" id="faceImage" name="faceImage" class="form-control" accept="image/*">
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn primary-btn">Enroll Face</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="preview-container" style="display:none;">
            <h3>Preview</h3>
            <img id="preview" src="" alt="Face preview">
            <div class="preview-actions">
                <button id="retake-btn" class="btn secondary-btn">Retake</button>
                <button id="use-btn" class="btn primary-btn">Use This Photo</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const video = document.getElementById('video');
            const canvas = document.getElementById('canvas');
            const captureBtn = document.getElementById('capture-btn');
            const previewContainer = document.querySelector('.preview-container');
            const previewImg = document.getElementById('preview');
            const retakeBtn = document.getElementById('retake-btn');
            const useBtn = document.getElementById('use-btn');
            const enrollmentForm = document.getElementById('enrollment-form');
            
            // Get access to the camera
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ video: true })
                    .then(function(stream) {
                        video.srcObject = stream;
                    })
                    .catch(function(error) {
                        console.error("Camera error: ", error);
                    });
            }
            
            // Capture photo
            captureBtn.addEventListener('click', function() {
                const context = canvas.getContext('2d');
                context.drawImage(video, 0, 0, 400, 300);

               const imageDataUrl = canvas.toDataURL('image/jpeg');
                previewImg.src = imageDataUrl;

                // Show preview container, hide video
                previewContainer.style.display = 'block';
                document.querySelector('.video-container').style.display = 'none';
                document.querySelector('.capture-controls').style.display = 'none';
            });

            // Retake photo
            retakeBtn.addEventListener('click', function() {
                previewContainer.style.display = 'none';
                document.querySelector('.video-container').style.display = 'block';
                document.querySelector('.capture-controls').style.display = 'block';
            });

            // Use this photo
            useBtn.addEventListener('click', function() {
                // Convert data URL to blob
                fetch(previewImg.src)
                    .then(res => res.blob())
                    .then(blob => {
                        // Create a File object
                        const file = new File([blob], "face.jpg", { type: "image/jpeg" });

                        // Create a FileList-like object
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);

                        // Assign to the file input
                        document.getElementById('faceImage').files = dataTransfer.files;

                        // Submit the form
                        enrollmentForm.submit();
                    });
            });
        });
    </script>
}